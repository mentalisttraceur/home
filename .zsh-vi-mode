function _vi_mode_indicators_update
{
    local mode_indicator=?
    case $KEYMAP in
    'vicmd')
        mode_indicator=-
        printf '\e[2 q'
    ;;
    'main')
        case $(bindkey -lL main) in
        'bindkey -A viins main')
            case $ZLE_STATE in
            *overwrite*)
                mode_indicator=R
                printf '\e[4 q'
            ;;
            *)
                mode_indicator=I
                printf '\e[6 q'
            esac
        ;;
        'bindkey -A emacs main')
            mode_indicator=E
            printf '\e[0 q'
        esac
    esac
    PS1=$mode_indicator${PS1#?}
    PS2=$mode_indicator${PS2#?}
    PS3=$mode_indicator${PS3#?}
}

_vi_mode_indicators_need_init=1
_vi_mode_previous_keymap=vicmd

function zle-line-init
{
    case $_vi_mode_indicators_need_init in 1)
        PS1=?$PS1
        PS2=?$PS2
        PS3=?$PS3
        _vi_mode_indicators_need_init=0
    esac
    case $_vi_mode_previous_keymap in vicmd)
         zle .vi-cmd-mode
    esac
    _vi_mode_indicators_update
    zle reset-prompt
}
zle -N zle-line-init

function zle-keymap-select
{
    _vi_mode_indicators_update
    zle reset-prompt
}
zle -N zle-keymap-select

function zle-line-finish
{
    PS1=${PS1#?}
    PS2=${PS2#?}
    PS3=${PS3#?}
    printf '\e[0 q'
    _vi_mode_indicators_need_init=1
    _vi_mode_previous_keymap=$KEYMAP
    zle reset-prompt
}
zle -N zle-line-finish

function vi-replace-chars()
{
    printf '\e[4 q'
    zle .vi-replace-chars
    printf '\e[2 q'
}
zle -N vi-replace-chars


function _history-search-previous()
{
    zle .history-incremental-pattern-search-backward $BUFFER
}
function _history-search-next()
{
    zle .history-incremental-pattern-search-forward $BUFFER
}
zle -N history-incremental-pattern-search-backward _history-search-previous
zle -N history-incremental-pattern-search-backward _history-search-next
bindkey -M vicmd "?" .history-incremental-pattern-search-backward
bindkey -M vicmd "/" .history-incremental-pattern-search-forward
bindkey -M vicmd "N" history-incremental-pattern-search-backward
bindkey -M vicmd "n" history-incremental-pattern-search-forward


function _vi-clipboard-copy()
{
    printf '\e]52;c;'
    base64 -w0
    printf '\a'
}

function vi-yank()
{
    zle .vi-yank &&
    printf '%s' "$CUTBUFFER" | _vi-clipboard-copy
}
zle -N vi-yank
function vi-yank-whole-line()
{
    zle .vi-yank-whole-line &&
    printf '%s' "$CUTBUFFER" | _vi-clipboard-copy
}
zle -N vi-yank-whole-line

function vi-delete()
{
    zle .vi-delete &&
    printf '%s' "$CUTBUFFER" | _vi-clipboard-copy
}
zle -N vi-delete
function vi-delete-eol()
{
    zle .vi-delete-eol &&
    printf '%s' "$CUTBUFFER" | _vi-clipboard-copy
}
zle -N vi-delete-eol

function vi-change()
{
    zle .vi-change &&
    printf '%s' "$CUTBUFFER" | _vi-clipboard-copy
}
zle -N vi-change
function vi-change-eol()
{
    zle .vi-change-eol &&
    printf '%s' "$CUTBUFFER" | _vi-clipboard-copy
}
zle -N vi-change-eol

function vi-delete-char()
{
    zle .vi-delete-char &&
    printf '%s' "$CUTBUFFER" | _vi-clipboard-copy
}
zle -N vi-delete-char
function vi-backward-delete-char()
{
    zle .vi-backward-delete-char &&
    printf '%s' "$CUTBUFFER" | _vi-clipboard-copy
}
zle -N vi-backward-delete-char


function vi-put-before()
{
    local cursor_position=$CURSOR &&
    zle .vi-put-before &&
    CURSOR=$cursor_position
}
zle -N vi-put-before


function vi-cmd-mode() {
    case $ZLE_STATE in *overwrite*)
         zle vi-insert
         zle zle-keymap-select
         return
    esac
    zle .vi-cmd-mode
    CURSOR=$((CURSOR + 1))
}
zle -N vi-cmd-mode
