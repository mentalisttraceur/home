function _vi_mode_indicators_update
{
    local mode_indicator=?
    case $KEYMAP in
    'vicmd')
        mode_indicator=-
        printf '\e[2 q'
    ;;
    'main')
        case $(bindkey -lL main) in
        'bindkey -A viins main')
            case $ZLE_STATE in
            *overwrite*)
                mode_indicator=R
                printf '\e[4 q'
            ;;
            *)
                mode_indicator=I
                printf '\e[6 q'
            esac
        ;;
        'bindkey -A emacs main')
            mode_indicator=E
            printf '\e[0 q'
        esac
    esac
    PS1=$mode_indicator${PS1#?}
    PS2=$mode_indicator${PS2#?}
    PS3=$mode_indicator${PS3#?}
}

_vi_mode_indicators_need_init=1

function zle-line-init
{
    case $_vi_mode_indicators_need_init in 1)
        PS1=?$PS1
        PS2=?$PS2
        PS3=?$PS3
        _vi_mode_indicators_need_init=0
    esac
    _vi_mode_indicators_update
    zle reset-prompt
}
zle -N zle-line-init

function zle-keymap-select
{
    _vi_mode_indicators_update
    zle reset-prompt
}
zle -N zle-keymap-select

function zle-line-finish
{
    PS1=${PS1#?}
    PS2=${PS2#?}
    PS3=${PS3#?}
    printf '\e[0 q'
    _vi_mode_indicators_need_init=1
    zle reset-prompt
}
zle -N zle-line-finish

function vi-replace-chars()
{
    printf '\e[4 q'
    zle .vi-replace-chars
    printf '\e[2 q'
}
zle -N vi-replace-chars
