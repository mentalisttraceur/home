function _vi-clipboard-copy()
{
    printf '\e]52;c;'
    base64 -w0
    printf '\a'
}


function vi-yank()
{
    zle .vi-yank &&
    printf '%s' "$CUTBUFFER" | _vi-clipboard-copy
}
zle -N vi-yank

