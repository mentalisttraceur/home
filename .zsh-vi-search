function history-incremental-pattern-search-backward-continue()
{
    zle history-incremental-pattern-search-backward $BUFFER
}
function history-incremental-pattern-search-forward-continue()
{
    zle history-incremental-pattern-search-forward $BUFFER
}
zle -N history-incremental-pattern-search-backward-continue
zle -N history-incremental-pattern-search-forward-continue
bindkey -M vicmd "?" history-incremental-pattern-search-backward
bindkey -M vicmd "/" history-incremental-pattern-search-forward
bindkey -M vicmd "N" history-incremental-pattern-search-backward-continue
bindkey -M vicmd "n" history-incremental-pattern-search-forward-continue
